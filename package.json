{
  "name": "iisl",
  "version": "0.1.0",
  "private": true,
  "description": "support_overlay \u2014 Issue Resolution Integrity Layer (IRIL) prototype",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "demo:start": "node scripts/demo-start-bootstrap.js",
    "demo:start:internal": "ts-node -r ./scripts/lib/load-env-preload.js -P tsconfig.base.json scripts/demo-start.ts",
    "demo:reset": "ts-node -r ./scripts/lib/load-env-preload.js -P tsconfig.base.json scripts/demo-reset.ts",
    "demo:smoke": "ts-node -r ./scripts/lib/load-env-preload.js -P tsconfig.base.json scripts/demo-smoke.ts",
    "doctor": "ts-node -r ./scripts/lib/load-env-preload.js -P tsconfig.base.json scripts/doctor.ts",
    "build:workspace-libs": "npm run build --workspace=packages/shared && npm run build --workspace=packages/extraction && npm run build --workspace=packages/matching && npm run build --workspace=packages/connectors && npm run build --workspace=packages/policy",
    "dev": "npm run build:workspace-libs && node scripts/dev-bootstrap.js",
    "db:migrate": "ts-node -r ./scripts/lib/load-env-preload.js -P tsconfig.base.json scripts/migrate.ts",
    "db:seed": "ts-node -r ./scripts/lib/load-env-preload.js -P tsconfig.base.json scripts/seed.ts",
    "db:reset": "ts-node -r ./scripts/lib/load-env-preload.js -P tsconfig.base.json scripts/migrate.ts --reset",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "lint": "eslint . && npm run typecheck",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run build:workspace-libs && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/sidebar/tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "app:package": "ts-node -P tsconfig.scripts.json scripts/package-zendesk-app.ts",
    "app:validate": "ts-node -P tsconfig.scripts.json -e \"const {validateManifest}=require('./scripts/lib/manifest-validator');const m=require('./apps/sidebar/manifest.json');const e=validateManifest(m);if(e.length){console.error(e.join('\\n'));process.exit(1)}console.log('manifest ok')\""
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.11",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.0",
    "eslint": "^8.57.0",
    "pg": "^8.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
