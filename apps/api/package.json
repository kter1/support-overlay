{
  "name": "@iisl/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --project tsconfig.json src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "ts-node -P ../../tsconfig.base.json ../../scripts/migrate.ts",
    "test": "vitest run",
    "dev:worker": "ts-node-dev --respawn --transpile-only --project tsconfig.json src/worker.ts",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@iisl/connectors": "*",
    "@iisl/matching": "*",
    "@iisl/shared": "*",
    "crypto": "^1.0.1",
    "fastify": "^4.26.0",
    "pg": "^8.11.3",
    "pino": "^8.18.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.4",
    "@iisl/extraction": "*"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/pg": "^8.11.2",
    "@types/uuid": "^9.0.7",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  }
}
